{
  "name": "gitask-monorepo",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p packages/cli && tsc -p packages/vscode && tsc -p packages/ui",
    "test": "node --test packages/core/test/*.test.ts packages/cli/test/*.test.ts packages/vscode/test/*.test.ts",
    "build": "pnpm --workspace-concurrency=1 --filter gitask-cli --filter gitask-vscode run build",
    "package": "pnpm --filter gitask-vscode run package",
    "bump": "node scripts/bump.mjs",
    "deploy:pro": "pnpm --filter gitask-web run deploy"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.18"
  }
}
