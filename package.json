{
  "name": "gitask-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p packages/cli && tsc -p packages/vscode",
    "test": "node --test packages/core/test/*.test.ts",
    "build": "pnpm --filter gitask-cli --filter gitask-vscode run build",
    "package": "pnpm --filter gitask-vscode run package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  }
}
