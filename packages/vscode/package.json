{
  "name": "gitask-vscode",
  "displayName": "GITASK",
  "description": "Git-backed Kanban for a Tasks/ folder. Drag a card, the file moves and the change is committed.",
  "version": "0.5.0",
  "publisher": "vannseavlong",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/vannseavlong/GITASK#readme",
  "bugs": { "url": "https://github.com/vannseavlong/GITASK/issues" },
  "keywords": ["kanban", "tasks", "git", "markdown", "board"],
  "galleryBanner": { "color": "#1e293b", "theme": "dark" },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/Tasks/1-backlog"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitask.openBoard",
        "title": "GITASK: Open Board"
      },
      {
        "command": "gitask.newTask",
        "title": "GITASK: New Task"
      },
      {
        "command": "gitask.initTasks",
        "title": "GITASK: Initialize Tasks Folder"
      },
      {
        "command": "gitask.syncGithub",
        "title": "GITASK: Sync to GitHub"
      }
    ],
    "configuration": {
      "title": "GITASK",
      "properties": {
        "gitask.tasksDir": {
          "type": "string",
          "default": "Tasks",
          "description": "Tasks folder, relative to the workspace root."
        },
        "gitask.staleDays": {
          "type": "number",
          "default": 14,
          "minimum": 1,
          "description": "Overview: a task not updated for this many days is listed as stale."
        },
        "gitask.autoCommit": {
          "type": "boolean",
          "default": true,
          "description": "Commit the task file when a card is moved. Never pushes."
        },
        "gitask.commitMessage": {
          "type": "string",
          "default": "task({id}): {from} → {to}",
          "description": "Commit message. {id}, {from}, {to} are replaced."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter gitask-ui run build && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "package": "pnpm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "gitask-core": "workspace:*",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vannseavlong/GITASK.git",
    "directory": "packages/vscode"
  }
}
